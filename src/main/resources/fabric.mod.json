{
	"schemaVersion": 1,
	"id": "multiscoreboard",
	"version": "${version}",
	"name": "MultiScoreboard",
	"description": "This mod allows multiple scoreboards to be displayed on the sidebar at once.",
	"authors": [
		"Papierkorb2292"
	],
	"contact": {
		"sources": "https://github.com/Papierkorb2292/MultiScoreboard",
		"issues": "https://github.com/Papierkorb2292/MultiScoreboard/issues"
	},
	"license": "CC0-1.0",
	"icon": "assets/multiscoreboard/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.papierkorb2292.multiscoreboard.MultiScoreboard"
		],
		"client": [
			"net.papierkorb2292.multiscoreboard.client.MultiScoreboardClient"
		],
		"modmenu": [
			"net.papierkorb2292.multiscoreboard.client.MultiScoreboardModMenu"
		]
    },
	"mixins": [
		"multiscoreboard.mixins.json",
        {
          "config": "multiscoreboard.client.mixins.json",
          "environment": "client"
        }
	],
	"depends": {
		"fabricloader": ">=0.15.0",
		"minecraft": "26.3.*",
		"java": ">=21",
		"fabric-api": "*"
	}
}